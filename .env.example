# Database (Neon Postgres)
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_SSL=true
DB_CHANNEL_BINDING=require

# Full connection string (kept for libraries that expect a single URL)
# Pooled (PgBouncer) — used by the app at runtime
DATABASE_URL=
# Direct (non-pooled) — required by Prisma Migrate, which needs prepared statements PgBouncer doesn't support
DIRECT_URL=

# S3-compatible storage (Neon)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

PORT=3000
NODE_ENV=development
