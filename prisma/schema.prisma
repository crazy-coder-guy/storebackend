generator client {
  provider      = "prisma-client-js"
  // Render deploys this via Dockerfile on node:20-alpine (musl libc, OpenSSL
  // 3.0 — no libssl.so.1.1). The build step couldn't auto-detect OpenSSL and
  // defaulted to an incompatible musl/OpenSSL-1.1 engine, so pin the correct
  // target explicitly: "native" for local dev (macOS), "linux-musl-openssl-3.0.x"
  // for the Alpine container.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
  LAUNCHING_SOON
}

enum ImageType {
  PRODUCT
  MODEL
  LIFESTYLE
}

enum TransactionType {
  RESTOCK
  MANUAL_INCREASE
  MANUAL_DECREASE
  ADJUSTMENT
}

enum ProductFit {
  REGULAR
  SLIM
  OVERSIZED
  RELAXED
}

enum NeckType {
  CREW
  V_NECK
  POLO
  ROUND
  MOCK
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PAID
  UNPAID
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

model Category {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  description String?
  badge       String?
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String?
  categoryId  String        @map("category_id")
  productType String        @map("product_type")
  basePrice   Decimal       @map("base_price")
  mrp         Decimal
  // Base manufacturing/procurement cost — never exposed to the storefront.
  // A variant can override this via ProductVariant.costPrice; this is the
  // fallback used when a variant doesn't set its own.
  costPrice   Decimal?      @map("cost_price")
  badge       String?
  status      ProductStatus @default(DRAFT)
  gsm         Int?
  fabric      String?
  fit         ProductFit?
  neckType    NeckType?     @map("neck_type")
  biowash     Boolean       @default(false)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  category  Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images    ProductImage[]
  variants  ProductVariant[]
  featured  FeaturedProduct?
  favorites Favorite[]
  reviews   Review[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id        String    @id @default(uuid())
  productId String    @map("product_id")
  colorId   String?   @map("color_id")
  imageUrl  String    @map("image_url")
  imageType ImageType @map("image_type")
  sortOrder Int       @default(0) @map("sort_order")
  isPrimary Boolean   @default(false) @map("is_primary")
  createdAt DateTime  @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   Color?  @relation(fields: [colorId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([colorId])
  @@map("product_images")
}

model Size {
  id        String       @id @default(uuid())
  name      String       @unique
  code      String       @unique
  sortOrder Int          @default(0) @map("sort_order")
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  variants ProductVariant[]

  @@map("sizes")
}

model Color {
  id        String       @id @default(uuid())
  name      String       @unique
  code      String       @unique
  hexCode   String       @map("hex_code")
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  variants ProductVariant[]
  images   ProductImage[]

  @@map("colors")
}

model ProductVariant {
  id            String       @id @default(uuid())
  productId     String       @map("product_id")
  colorId       String?      @map("color_id")
  sizeId        String       @map("size_id")
  sku           String       @unique
  price         Decimal?
  // Per-variant override of Product.costPrice — same fallback pattern as
  // `price` overriding Product.basePrice. Never exposed to the storefront.
  costPrice     Decimal?     @map("cost_price")
  stockQuantity Int          @default(0) @map("stock_quantity")
  badge         String?
  status        EntityStatus @default(ACTIVE)
  // Per-size garment measurements (all in inches, optional)
  chestWidth    Decimal?     @map("chest_width")
  bodyLength    Decimal?     @map("body_length")
  sleeveLength  Decimal?     @map("sleeve_length")
  shoulderWidth Decimal?     @map("shoulder_width")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  color                 Color?                 @relation(fields: [colorId], references: [id], onDelete: SetNull)
  size                  Size                   @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  inventoryTransactions InventoryTransaction[]
  orderItems            OrderItem[]
  cartItems             CartItem[]

  @@index([productId])
  @@index([colorId])
  @@index([sizeId])
  @@index([productId, sizeId])
  @@map("product_variants")
}

model InventoryTransaction {
  id              String          @id @default(uuid())
  variantId       String          @map("variant_id")
  transactionType TransactionType @map("transaction_type")
  quantity        Int
  previousStock   Int             @map("previous_stock")
  newStock        Int             @map("new_stock")
  reason          String?
  createdAt       DateTime        @default(now()) @map("created_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("inventory_transactions")
}

// Singleton row (id is always "default") holding the customer storefront's
// editable copy — the top announcement bar and homepage hero text.
model StorefrontSetting {
  id                String    @id @default("default")
  announcementText  String    @map("announcement_text")
  heroTitle         String    @map("hero_title")
  heroSubtitle      String    @map("hero_subtitle")
  isMaintenance     Boolean   @default(false) @map("is_maintenance")
  maintenanceUntil  DateTime? @map("maintenance_until")
  maintenanceNotice String?   @map("maintenance_notice")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("storefront_settings")
}

// Singleton row (id is always "default") holding the admin-configurable cost
// assumptions used to compute recommended selling prices and per-order
// profit — separate from StorefrontSetting since this is internal cost
// config, never exposed to the storefront, vs. that model's public-facing copy.
model PricingSetting {
  id                    String   @id @default("default")
  packagingCost         Decimal  @default(20) @map("packaging_cost")
  courierCost           Decimal  @default(65) @map("courier_cost")
  paymentGatewayPercent Decimal  @default(2.5) @map("payment_gateway_percent")
  exchangeBuffer        Decimal  @default(20) @map("exchange_buffer")
  miscCost              Decimal  @default(10) @map("misc_cost")
  marketingCost         Decimal  @default(75) @map("marketing_cost")
  targetProfit          Decimal  @default(150) @map("target_profit")
  freeShippingThreshold Decimal  @default(999) @map("free_shipping_threshold")
  shippingCharge        Decimal  @default(59) @map("shipping_charge")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("pricing_settings")
}

model FeaturedProduct {
  id        String   @id @default(uuid())
  productId String   @unique @map("product_id")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([sortOrder])
  @@map("featured_products")
}

// One row per search performed on the customer storefront, so the admin can
// see what people are actually searching for (and spot zero-result gaps).
model SearchLog {
  id              String   @id @default(uuid())
  query           String
  normalizedQuery String   @map("normalized_query")
  resultsCount    Int      @map("results_count")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([normalizedQuery])
  @@index([createdAt])
  @@map("search_logs")
}

// A signed-in order's name/phone/email are stored directly on Order as a
// snapshot at checkout time (like shippingAddress already was) rather than
// through a separate Customer entity — checkout requires auth, so the
// buyer's account is always `user`, and their name/phone can differ per
// order (e.g. ordering for someone else) without that history being
// overwritten by a later profile edit.
model Order {
  id                String        @id @default(uuid())
  orderNumber       String        @unique @map("order_number")
  userId            String        @map("user_id")
  customerName      String        @map("customer_name")
  customerPhone     String        @map("customer_phone")
  customerEmail     String        @map("customer_email")
  status            OrderStatus   @default(PENDING)
  paymentStatus     PaymentStatus @default(UNPAID) @map("payment_status")
  totalAmount       Decimal       @map("total_amount")
  shippingAddress   String        @map("shipping_address")
  doorNumber        String?       @map("door_number")
  streetName        String?       @map("street_name")
  city              String?
  state             String?
  pincode           String?
  razorpayOrderId   String?       @unique @map("razorpay_order_id")
  razorpayPaymentId String?       @map("razorpay_payment_id")
  razorpaySignature String?       @map("razorpay_signature")
  deliveredAt       DateTime?     @map("delivered_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  couponId       String? @map("coupon_id")
  discountAmount Decimal @default(0) @map("discount_amount")

  // Order-level shipping fee actually charged to the customer (visible to
  // them, unlike everything below) — split out of totalAmount so it's not
  // re-derived later from the (possibly since-changed) pricing settings.
  shippingFee Decimal @default(0) @map("shipping_fee")

  // Cost/profit snapshot at order time — never exposed to the storefront.
  // Snapshotted (not re-derived later) so historical profit reporting stays
  // accurate even if product costs or pricing settings change afterward.
  // Courier/packaging are order-level (charged once per order, not per
  // item); productCostTotal is the sum of each OrderItem's costPrice*quantity.
  productCostTotal  Decimal @default(0) @map("product_cost_total")
  packagingCost     Decimal @default(0) @map("packaging_cost")
  courierCost       Decimal @default(0) @map("courier_cost")
  paymentGatewayFee Decimal @default(0) @map("payment_gateway_fee")
  marketingCost     Decimal @default(0) @map("marketing_cost")
  exchangeBuffer    Decimal @default(0) @map("exchange_buffer")
  miscCost          Decimal @default(0) @map("misc_cost")
  netContribution   Decimal @default(0) @map("net_contribution")

  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  items            OrderItem[]
  reviews          Review[]
  exchangeRequests ExchangeRequest[]
  coupon           Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponRedemption CouponRedemption?

  @@index([userId])
  @@index([status])
  @@index([couponId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  variantId String  @map("variant_id")
  quantity  Int
  unitPrice Decimal @map("unit_price")
  // Snapshot of the variant/product cost at order time — mirrors unitPrice,
  // never exposed to the storefront. Used for per-product profit reporting.
  costPrice Decimal @default(0) @map("cost_price")

  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant          ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  exchangeRequests ExchangeRequest[]

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

enum ExchangeReason {
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  SIZE_FIT
  OTHER
}

enum ExchangeStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

// A customer-raised request to exchange a delivered item — e.g. it arrived
// damaged. Admin reviews the photos/description and moves it through the
// status workflow; this tracks the request itself, not the fulfillment of a
// replacement shipment.
model ExchangeRequest {
  id          String         @id @default(uuid())
  orderId     String         @map("order_id")
  orderItemId String         @map("order_item_id")
  userId      String         @map("user_id")
  reason      ExchangeReason
  description String
  images      String[]       @default([])
  status      ExchangeStatus @default(PENDING)
  adminNote   String?        @map("admin_note")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderItemId])
  @@index([userId])
  @@index([status])
  @@map("exchange_requests")
}

// A storefront account, created on first successful Google sign-in
// (Firebase Auth) — also the "customer" record admin sees, since checkout
// now always requires being signed in.
model User {
  id          String       @id @default(uuid())
  firebaseUid String       @unique @map("firebase_uid")
  email       String       @unique
  name        String?
  photoUrl    String?      @map("photo_url")
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  cart              Cart?
  favorites         Favorite[]
  pushSubscriptions PushSubscription[]
  addresses         Address[]
  reviews           Review[]
  visits            Visit[]
  orders            Order[]
  exchangeRequests  ExchangeRequest[]
  couponRedemptions CouponRedemption[]

  @@map("users")
}

// Saved checkout recipient profiles (name + phone + shipping address),
// capped at 3 per user by address.service.ts — the oldest is evicted when a
// new one is saved past the cap, so this table never needs its own cleanup.
model Address {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  name            String
  phone           String
  shippingAddress String   @map("shipping_address")
  doorNumber      String?  @map("door_number")
  streetName      String?  @map("street_name")
  city            String?
  state           String?
  pincode         String?
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("push_subscriptions")
}

model PushNotification {
  id           String   @id @default(uuid())
  title        String
  body         String
  url          String?
  image        String?
  actions      Json?
  targetUserId String?  @map("target_user_id")
  successCount Int      @default(0) @map("success_count")
  failureCount Int      @default(0) @map("failure_count")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("push_notifications")
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  name      String
  title     String
  body      String
  url       String?
  image     String?
  actions   Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notification_templates")
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  couponId  String?  @map("coupon_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]
  coupon Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  variantId String   @map("variant_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// A discount code the admin creates and a customer enters on the cart/
// checkout — `value` is either a percentage (0-100) or a flat rupee amount
// depending on `type`. `usedCount` tracks total redemptions against
// `usageLimit`; `perUserLimit` (via CouponRedemption, one row per order) caps
// how many times a single customer can redeem it, typically 1.
model Coupon {
  id                String       @id @default(uuid())
  code              String       @unique
  type              CouponType
  value             Decimal
  minOrderValue     Decimal?     @map("min_order_value")
  maxDiscountAmount Decimal?     @map("max_discount_amount")
  usageLimit        Int?         @map("usage_limit")
  usedCount         Int          @default(0) @map("used_count")
  perUserLimit      Int          @default(1) @map("per_user_limit")
  expiresAt         DateTime?    @map("expires_at")
  status            EntityStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  carts       Cart[]
  orders      Order[]
  redemptions CouponRedemption[]

  @@map("coupons")
}

// One row per order that actually redeemed a coupon — the source of truth
// for "has this user already used this coupon" and for usage stats, rather
// than trying to infer it from Order.couponId (which an admin could null out).
model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String   @map("coupon_id")
  userId    String   @map("user_id")
  orderId   String   @unique @map("order_id")
  createdAt DateTime @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@map("coupon_redemptions")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorites")
}

// A rating + comment left by a user who has an order marked DELIVERED for
// this product ("Verified Purchase") — one review per user per product,
// like Flipkart. Photos/video are optional; rating and comment are not.
model Review {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  userId    String   @map("user_id")
  orderId   String   @map("order_id")
  rating    Int
  comment   String
  images    String[] @default([])
  video     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

// One row per storefront session — where the visitor is browsing from
// (IP-based geolocation) and what they're browsing with (parsed from their
// User-Agent). Tied to User when signed in, but also recorded for signed-out
// visitors so overall traffic patterns are visible, not just customers'.
model Visit {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  ipAddress  String   @map("ip_address")
  country    String?
  region     String?
  city       String?
  deviceType String   @map("device_type")
  os         String?
  browser    String?
  userAgent  String   @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("visits")
}

// Footer "Stay Connected" opt-in — deliberately not tied to User, since a
// storefront visitor can subscribe without ever signing in.
model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
}
