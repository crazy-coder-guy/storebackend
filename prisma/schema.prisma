generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum ImageType {
  PRODUCT
  MODEL
  LIFESTYLE
}

enum TransactionType {
  RESTOCK
  MANUAL_INCREASE
  MANUAL_DECREASE
  ADJUSTMENT
}

enum ProductFit {
  REGULAR
  SLIM
  OVERSIZED
  RELAXED
}

enum NeckType {
  CREW
  V_NECK
  POLO
  ROUND
  MOCK
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PAID
  UNPAID
  REFUNDED
}

model Category {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  description String?
  badge       String?
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String?
  categoryId  String        @map("category_id")
  productType String        @map("product_type")
  basePrice   Decimal       @map("base_price")
  mrp         Decimal
  badge       String?
  status      ProductStatus @default(DRAFT)
  gsm         Int?
  fabric      String?
  fit         ProductFit?
  neckType    NeckType?     @map("neck_type")
  biowash     Boolean       @default(false)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  category  Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images    ProductImage[]
  variants  ProductVariant[]
  featured  FeaturedProduct?
  favorites Favorite[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id         String    @id @default(uuid())
  productId  String    @map("product_id")
  imageUrl   String    @map("image_url")
  imageType  ImageType @map("image_type")
  sortOrder  Int       @default(0) @map("sort_order")
  isPrimary  Boolean   @default(false) @map("is_primary")
  createdAt  DateTime  @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Size {
  id        String       @id @default(uuid())
  name      String       @unique
  code      String       @unique
  sortOrder Int          @default(0) @map("sort_order")
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  variants ProductVariant[]

  @@map("sizes")
}

model Color {
  id        String       @id @default(uuid())
  name      String       @unique
  code      String       @unique
  hexCode   String       @map("hex_code")
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  variants ProductVariant[]

  @@map("colors")
}

model ProductVariant {
  id            String       @id @default(uuid())
  productId     String       @map("product_id")
  colorId       String       @map("color_id")
  sizeId        String       @map("size_id")
  sku           String       @unique
  price         Decimal?
  stockQuantity Int          @default(0) @map("stock_quantity")
  badge         String?
  status        EntityStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  product                Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  color                  Color                  @relation(fields: [colorId], references: [id], onDelete: Restrict)
  size                   Size                   @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  inventoryTransactions  InventoryTransaction[]
  orderItems             OrderItem[]
  cartItems              CartItem[]

  @@unique([productId, colorId, sizeId])
  @@index([productId])
  @@index([colorId])
  @@index([sizeId])
  @@map("product_variants")
}

model InventoryTransaction {
  id              String          @id @default(uuid())
  variantId       String          @map("variant_id")
  transactionType TransactionType @map("transaction_type")
  quantity        Int
  previousStock   Int             @map("previous_stock")
  newStock        Int             @map("new_stock")
  reason          String?
  createdAt       DateTime        @default(now()) @map("created_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("inventory_transactions")
}

// Singleton row (id is always "default") holding the customer storefront's
// editable copy — the top announcement bar and homepage hero text.
model StorefrontSetting {
  id               String   @id @default("default")
  announcementText String   @map("announcement_text")
  heroTitle        String   @map("hero_title")
  heroSubtitle     String   @map("hero_subtitle")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("storefront_settings")
}

model FeaturedProduct {
  id        String   @id @default(uuid())
  productId String   @unique @map("product_id")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([sortOrder])
  @@map("featured_products")
}

// One row per search performed on the customer storefront, so the admin can
// see what people are actually searching for (and spot zero-result gaps).
model SearchLog {
  id              String   @id @default(uuid())
  query           String
  normalizedQuery String   @map("normalized_query")
  resultsCount    Int      @map("results_count")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([normalizedQuery])
  @@index([createdAt])
  @@map("search_logs")
}

model Customer {
  id        String       @id @default(uuid())
  name      String
  email     String       @unique
  phone     String
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  orders Order[]

  @@map("customers")
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique @map("order_number")
  customerId      String        @map("customer_id")
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID) @map("payment_status")
  totalAmount     Decimal       @map("total_amount")
  shippingAddress String        @map("shipping_address")
  razorpayOrderId String?       @map("razorpay_order_id")
  razorpayPaymentId String?     @map("razorpay_payment_id")
  razorpaySignature String?     @map("razorpay_signature")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    OrderItem[]

  @@index([customerId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  variantId String  @map("variant_id")
  quantity  Int
  unitPrice Decimal @map("unit_price")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

// A storefront account, created on first successful Google sign-in
// (Firebase Auth). Not the same as Customer, which is a per-order billing
// contact and may never correspond to an authenticated account.
model User {
  id          String   @id @default(uuid())
  firebaseUid String   @unique @map("firebase_uid")
  email       String   @unique
  name        String?
  photoUrl    String?  @map("photo_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cart      Cart?
  favorites Favorite[]

  @@map("users")
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  variantId String   @map("variant_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorites")
}
